{
  "info": {
    "_postman_id": "ziptrrip-todo-collection-v1",
    "name": "Ziptrrip Todo API Collection",
    "description": "Complete REST API Postman Collection for Ziptrrip Todo Assessment Backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["health"]
        }
      }
    },
    {
      "name": "Get All Todos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/todos?page=1&limit=10",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "todos"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "Get Filtered Todos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/todos?filter=pending",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "todos"],
          "query": [
            { "key": "filter", "value": "pending" }
          ]
        }
      }
    },
    {
      "name": "Get Todo by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/todos/{{todoId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "todos", "{{todoId}}"]
        }
      }
    },
    {
      "name": "Create Todo",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Complete Ziptrrip Assessment\",\n  \"description\": \"Build full-stack todo app with MPA React + Node TypeScript + SQLite\",\n  \"priority\": \"high\",\n  \"due_date\": \"2026-07-28\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/todos",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "todos"]
        }
      }
    },
    {
      "name": "Update Todo",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Title\",\n  \"completed\": true,\n  \"priority\": \"high\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/todos/{{todoId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "todos", "{{todoId}}"]
        }
      }
    },
    {
      "name": "Toggle Todo Complete",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/todos/{{todoId}}/toggle",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "todos", "{{todoId}}", "toggle"]
        }
      }
    },
    {
      "name": "Delete Todo",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/todos/{{todoId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "todos", "{{todoId}}"]
        }
      }
    }
  ],
  "variable": [
    { "key": "todoId", "value": "replace-with-actual-todo-id" }
  ]
}